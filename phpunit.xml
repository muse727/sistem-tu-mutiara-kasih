<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Phase 8.1: switched from sqlite :memory: to MariaDB test database.
             SQLite is incompatible with MariaDB-specific SQL in several migrations
             (INNER JOIN in UPDATE, NOW(), FIELD(), enum modifiers).
             Test credentials come from the LOCAL testing environment (.env.testing),
             which is git-ignored and NOT committed. This file no longer forces a
             specific DB user/password. The dedicated, least-privilege test user is
             `sistem_tu_test` (privileges on `sistem_tu_test` only). -->
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_DATABASE" value="sistem_tu_test"/>
        <!-- DB_USERNAME / DB_PASSWORD intentionally NOT set here — sourced from the
             git-ignored .env.testing so no credential is hardcoded in committed source. -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
